{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dualloop.example.invalid/schemas/candidate-v0.4.json",
  "title": "Memory-aware executable candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "title",
    "question",
    "decision_type",
    "task_signature",
    "latent_z",
    "latent_alias",
    "boundary",
    "oracle_independence",
    "mechanism_fingerprint",
    "semantic_contrast",
    "deviations"
  ],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "candidate_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "title": {"type": "string", "minLength": 5},
    "question": {"type": "string", "minLength": 10},
    "decision_type": {
      "enum": ["yesno", "comparison", "selection", "threshold", "count_open"]
    },
    "task_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_var", "structure", "decision_type", "mechanism"],
      "properties": {
        "decision_var": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "structure": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "decision_type": {
          "enum": ["yesno", "comparison", "selection", "threshold", "count_open"]
        },
        "mechanism": {"type": "string", "minLength": 20}
      }
    },
    "latent_z": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "fields"],
      "properties": {
        "description": {"type": "string", "minLength": 20},
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    },
    "latent_alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "justification", "label_inputs"],
      "properties": {
        "mode": {"enum": ["tested_transforms", "not_applicable"]},
        "justification": {"type": "string", "minLength": 40},
        "label_inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observable", "quarantine"],
      "properties": {
        "observable": {"type": "string", "minLength": 20},
        "quarantine": {"type": "string", "minLength": 10}
      }
    },
    "oracle_independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_only", "forbidden_imports_absent"],
      "properties": {
        "image_only": {"const": true},
        "forbidden_imports_absent": {"const": true}
      }
    },
    "mechanism_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_family",
        "entities",
        "arity",
        "relation",
        "margin_operator",
        "oracle_primitives",
        "composition_depth"
      ],
      "properties": {
        "decision_family": {
          "enum": ["predicate", "comparison", "selection", "count", "composition"]
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "point", "line", "segment", "bar", "disk", "circle", "polygon",
              "region", "arc", "angle", "axis", "gauge", "set", "shape",
              "color", "attribute"
            ]
          }
        },
        "arity": {"enum": ["single", "pair", "triple", "set", "mixed"]},
        "relation": {
          "enum": [
            "proximity", "intersection", "magnitude", "containment", "angle",
            "count", "proportion", "collinearity", "order", "orientation",
            "distance", "spacing", "parity", "halfplane", "composition",
            "curvature", "convexity", "dispersion", "attribute_binding"
          ]
        },
        "margin_operator": {
          "enum": [
            "signed_distance", "signed_difference", "absolute_threshold",
            "top_gap", "minimum", "count_difference", "crowding_clearance",
            "angular_difference", "discrete_boundary", "composition_min"
          ]
        },
        "oracle_primitives": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "color_segmentation", "connected_components", "bounding_box",
              "centroid", "line_fit", "circle_fit", "polygon_fit", "arc_fit",
              "pixel_count", "distance_geometry", "composition"
            ]
          }
        },
        "composition_depth": {"type": "integer", "minimum": 1, "maximum": 4}
      }
    },
    "semantic_contrast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closest_known_worlds",
        "known_negative_matches",
        "contrast",
        "expected_information_gain"
      ],
      "properties": {
        "closest_known_worlds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}
        },
        "known_negative_matches": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}
        },
        "contrast": {"type": "string", "minLength": 80},
        "expected_information_gain": {"type": "string", "minLength": 40}
      }
    },
    "deviations": {"type": "array", "items": {"type": "string"}}
  }
}
