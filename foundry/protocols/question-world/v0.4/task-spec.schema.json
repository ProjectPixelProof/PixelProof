{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dualloop.example.invalid/schemas/task-spec-v0.4.json",
  "title": "Memory-aware traced foundry task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "mode",
    "protocol",
    "seed_set",
    "mechanism_memory",
    "negative_memory",
    "min_candidates",
    "max_candidates",
    "repair_turns",
    "max_turns",
    "timeout_seconds",
    "requires_clean_recycle",
    "min_logged_proposals",
    "max_build_starts",
    "min_ranking_passes",
    "semantic_neighbor_limit",
    "semantic_duplicate_threshold",
    "oracle_stress_seeds",
    "oracle_stress_scenes_per_seed",
    "search_phase_seconds",
    "triage_phase_seconds",
    "build_phase_seconds",
    "repair_phase_seconds",
    "finalization_phase_seconds"
  ],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "campaign_id": {"type": "string"},
    "mode": {"enum": ["discovery", "formal"]},
    "protocol": {"const": "question-world@0.4.0"},
    "seed_set": {"type": "string"},
    "mechanism_memory": {"const": "known-mechanisms@0.1.0"},
    "negative_memory": {"const": "rejected-mechanisms@0.1.0"},
    "min_candidates": {"type": "integer", "minimum": 1, "maximum": 10},
    "max_candidates": {"type": "integer", "minimum": 1, "maximum": 10},
    "repair_turns": {"type": "integer", "minimum": -1},
    "max_turns": {"type": "integer", "minimum": 1, "maximum": 200},
    "timeout_seconds": {"type": "integer", "minimum": 60},
    "requires_clean_recycle": {"const": true},
    "min_logged_proposals": {"type": "integer", "minimum": 1, "maximum": 100},
    "max_build_starts": {"type": "integer", "minimum": 1, "maximum": 20},
    "min_ranking_passes": {"type": "integer", "minimum": 2, "maximum": 5},
    "semantic_neighbor_limit": {"type": "integer", "minimum": 1, "maximum": 10},
    "semantic_duplicate_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "oracle_stress_seeds": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "oracle_stress_scenes_per_seed": {"type": "integer", "minimum": 12, "maximum": 100},
    "search_phase_seconds": {"type": "integer", "minimum": 1},
    "triage_phase_seconds": {"type": "integer", "minimum": 1},
    "build_phase_seconds": {"type": "integer", "minimum": 1},
    "repair_phase_seconds": {"type": "integer", "minimum": 1},
    "finalization_phase_seconds": {"type": "integer", "minimum": 1}
  }
}
